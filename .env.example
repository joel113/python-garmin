# Optional: needed only for fetching from Garmin.
GARMIN_API_KEY=

# Docker Compose publishes localhost on this port.
APP_PORT=8001

# Set these to the results of "id -u" and "id -g" for writable host mounts.
LOCAL_UID=1000
LOCAL_GID=1000

# Uncomment only after migrating the existing database into storage/.
# GARMIN_DB_PATH=storage/activities.sqlite3

# Optional for direct uv usage; this is already the default activity directory.
# GARMIN_ACTIVITIES_PATH=storage/activities

# Optional for direct uv usage with an explicitly configured browser hostname.
# GARMIN_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
